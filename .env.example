# ─────────────────────────────────────────────────────────────
# HoBom Angel Backend — env template.
# Real values are provisioned on the deploy server at
#   /etc/hobom-dev/dev-for-hobom-angel-backend/.env
# NEVER commit real secrets. Copy to `.env` for local dev.
# ─────────────────────────────────────────────────────────────

APP_NAME=hobom-angel-backend
NODE_ENV=development
HOBOM_ANGEL_BACKEND_PORT=8080

# CORS origin of the Angel FE (apps/hobom-angel). Comma-separated allowed.
HOBOM_CORS_ORIGIN=http://localhost:3001

# ── MongoDB (Angel DB in the shared "lion" Atlas cluster; Atlas = replica set) ──
# Same cluster as for-hobom-backend; Angel uses its own database
# `hobom-system-angel-backend-tiger-db`. Var name follows the lion convention.
HOBOM_SYSTEM_ANGEL_BACKEND_TIGER_DB=mongodb+srv://<user>:<pass>@hobom-system-lion-db.<host-hash>.mongodb.net/hobom-system-angel-backend-tiger-db?retryWrites=true&w=majority&appName=hobom-system-tiger-db

# ── JWT (Angel issues & verifies its own tokens; gateway does not own users) ──
HOBOM_JWT_SECRET=change-me-access-secret
HOBOM_JWT_ACCESS_TOKEN_EXPIRED=15m
HOBOM_JWT_REFRESH_SECRET=change-me-refresh-secret
HOBOM_JWT_REFRESH_TOKEN_EXPIRED=30d
HOBOM_GEN_SALT=10
# Auth cookies: Secure flag. Leave empty to follow NODE_ENV (on in production).
# Set false for a dev backend served over http://localhost, or the browser drops
# the Secure cookie.
COOKIE_SECURE=false

# ── Gateway trust (x-api-key issued by hobom-api-gateway SERVICE_API_KEYS) ──
GATEWAY_API_KEY=change-me-gateway-service-key

# ── Field encryption (AES-256-GCM). Key lives OUTSIDE the DB (KMS/secret mgr). ──
# 32-byte key, base64-encoded. Rotate per policy.
FIELD_ENCRYPTION_KEY=

# ── gRPC (outbox service exposed to hobom-event-processor). TLS optional. ──
HOBOM_GRPC_HOST=0.0.0.0
HOBOM_GRPC_PORT=50051
HOBOM_GRPC_API_KEY=change-me-grpc-api-key
HOBOM_GRPC_TLS_CERT=/etc/grpc-tls/tls.crt
HOBOM_GRPC_TLS_KEY=/etc/grpc-tls/tls.key

# ── Kafka topic (single topic per convention: hobom.angel-events) ──
# On the deploy server the broker is reached over the hobom-net docker network
# as `kafka:9092`. For a local non-docker run, use localhost:9092.
KAFKA_BROKERS=kafka:9092

# ── Redis (Angel BE cache/lock — vendor/URL TBD) ──
REDIS_URL=

# ── DLQ proxy target (hobom-event-processor internal API) ──
HOBOM_EVENT_PROCESSOR_HOST=dev-hobom-event-processor
HOBOM_EVENT_PROCESSOR_PORT=8082

# ── Image object storage: Cloudflare R2 (S3-compatible; presigned upload). ──
# Serve via the CDN in front of the bucket (R2 has $0 egress). Only required to
# issue upload URLs — the app boots without these.
HOBOM_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
HOBOM_R2_BUCKET=hobom-angel-images
HOBOM_R2_ACCESS_KEY_ID=
HOBOM_R2_SECRET_ACCESS_KEY=
HOBOM_R2_PUBLIC_BASE_URL=https://images.hobom.example

# ── Identity verification provider (CI/DI; vendor TBD, RRN never stored) ──
VERIFY_PROVIDER_BASE_URL=
VERIFY_PROVIDER_API_KEY=

# ── Optional: Discord webhook for 5xx alerts ──
HOBOM_DISCORD_WEBHOOK_URL=
